# Production config, kept at /srv/fastext/.env (mode 600, owned by fastext).
# setup-server.sh writes this file with generated secrets. This copy just documents it.
# Plain KEY=value lines, no quotes: systemd and python-decouple both read this file.

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=generate-a-long-random-string
ALLOWED_HOSTS=fastext.app

DB_NAME=fastext
DB_USER=fastext
DB_PASSWORD=generate-a-long-random-string

# Optional
# DB_HOST=localhost
# DB_PORT=3306
# CACHE_URL=redis://localhost:6379/1
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# ALLOW_REGISTRATION=False
